# OS files
.DS_Store

# Editor/IDE
.idea/
.vscode/
*.iml

# Environment files
.env
.env.*
!.env.example
!.env.prod.example
!.env.mail.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Backend (Java/Maven)
apps/backend/target/
apps/backend/**/surefire-reports/

# Frontend (Node toolchains)
apps/frontend/node_modules/
apps/frontend/dist/
apps/frontend/build/
apps/frontend/.next/
apps/frontend/.nuxt/
apps/frontend/.cache/
apps/frontend/coverage/

# Terraform/IaC local state
.terraform/
*.tfstate
*.tfstate.*

# Temporary files
*.tmp
*.temp

# --- Mail infrastructure -------------------------------------------------
# Generated mail data, queues, DKIM/TLS private keys and backup archives must
# never be tracked. Live env files are already covered by the .env.* rule above.
infra/mail/stalwart/config/*
!infra/mail/stalwart/config/*.example
infra/mail/stalwart/data/
infra/mail/backups/
*.dkim
*.pem
*.key
