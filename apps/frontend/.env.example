# Server-only URL used by the same-origin Next.js BFF routes. In Vercel set
# this to the Azure Container Apps backend URL ending in /api.
POTRIV_BACKEND_BASE_URL=http://localhost:8080/api

# Development console only. Never set this in Vercel production: production
# browsers talk to same-origin BFF routes and do not need the backend address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
