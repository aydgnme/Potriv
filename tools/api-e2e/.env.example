# API E2E configuration. Every value here is local-only and disposable.
# Copy to .env to override; the defaults work without one.

# Ports for the isolated stack. Chosen away from the normal dev ports
# (5432/1025/8025/8080) so a running dev stack is never disturbed.
E2E_DB_PORT=55432
E2E_SMTP_PORT=11025
E2E_MAIL_HTTP_PORT=18025
E2E_BACKEND_PORT=18080

# Where the suite points. Overriding this alone is NOT enough to reach a remote
# host — see the safety guard below.
# API_BASE_URL=http://127.0.0.1:18080/api

# Safety guard. Only localhost targets are allowed unless this is set.
# E2E_ALLOW_REMOTE=true
# Even then, mutating scenarios additionally require:
# E2E_ALLOW_DESTRUCTIVE_REMOTE=true

# Keep the isolated environment running after the suite finishes (debugging).
# E2E_KEEP_ENV=true

# Per-request timeout in milliseconds.
E2E_REQUEST_TIMEOUT_MS=10000
