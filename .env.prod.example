# Potriv production-like environment template.
#
#   cp .env.prod.example .env.prod   # then edit the values below
#
# .env.prod is git-ignored; never commit real secrets.

# --- PostgreSQL (internal-only in docker-compose.prod.yml) ---
POSTGRES_DB=potriv
POSTGRES_USER=potriv
POSTGRES_PASSWORD=change-me-in-production

# --- JWT ---
# At least 32 random bytes; the prod profile refuses the repository placeholder.
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-long-random-string
JWT_ISSUER=https://api.potriv.aydgn.me/api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Web ---
CORS_ALLOWED_ORIGINS=https://potriv.aydgn.me
FRONTEND_URL=https://potriv.aydgn.me
APP_BASE_URL=https://api.potriv.aydgn.me/api
SWAGGER_ENABLED=false

# --- Outbound mail ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@potriv.aydgn.me

# --- Seeded platform system admin (override before first boot) ---
# These credentials seed the SYSTEM_ADMIN account and are ALSO the browser
# login for the administration console (/api/admin/login). When the console is
# enabled in prod, the guard requires a real SYSTEM_ADMIN_PASSWORD: it refuses
# placeholder ("change-me"/"replace-me") or short (< 12 char) values.
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=change-me-in-production

# --- Embedded administration console (/api/admin/**) ---
# Disabled by default. When enabled, the console is protected by a server-side
# session form login backed by the SYSTEM_ADMIN account above (no separate
# console credentials). BACKEND_CONSOLE_USERNAME/PASSWORD are obsolete.
BACKEND_CONSOLE_ENABLED=false

# --- JVM ---
JAVA_OPTS=-XX:MaxRAMPercentage=75


