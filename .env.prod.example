# Potriv production-like environment template.
#
#   cp .env.prod.example .env.prod   # then edit the values below
#
# .env.prod is git-ignored; never commit real secrets.

# --- PostgreSQL (internal-only in docker-compose.prod.yml) ---
POSTGRES_DB=potriv
POSTGRES_USER=potriv
POSTGRES_PASSWORD=change-me-in-production

# --- JWT ---
# At least 32 random bytes; the prod profile refuses the repository placeholder.
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-long-random-string
JWT_ISSUER=https://api.potriv.aydgn.me/api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Web ---
CORS_ALLOWED_ORIGINS=https://potriv.aydgn.me
FRONTEND_URL=https://potriv.aydgn.me
APP_BASE_URL=https://api.potriv.aydgn.me/api
SWAGGER_ENABLED=false

# --- Outbound mail ---
# Point at the self-hosted mail service (docker-compose.mail.yml) by service
# name, or at any authenticated relay — the application needs no code change to
# switch between them.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@potriv.aydgn.me
# Bounded SMTP timeouts (milliseconds). Mail is sent synchronously inside the
# password-reset request, so these cap the worst case for an HTTP thread.
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# --- Rate limiting ---
# Backed by PostgreSQL (see V10 migration); enforced across every instance
# behind the load balancer. The app refuses to boot in this profile if
# enabled here without a real secret, and without exactly one of
# RATE_LIMIT_TRUSTED_PROXIES or RATE_LIMIT_NO_REVERSE_PROXY set below.
RATE_LIMIT_ENABLED=true
# At least 32 random bytes, distinct from JWT_SECRET; keys the rate-limit
# store so it never holds a plain email or IP address.
RATE_LIMIT_HMAC_SECRET=replace-with-a-strong-random-secret-distinct-from-jwt-secret
# Azure's own reverse proxy's real address range, as CIDR (comma-separated for
# more than one), e.g. the Container Apps / Front Door / Application Gateway
# subnet that actually sits in front of this backend. There is no safe
# invented default: get this from the deployment's real network topology
# before setting it, not from a generic Azure IP range found online — Azure
# service address ranges are region- and service-specific and change over
# time. Leave blank only if RATE_LIMIT_NO_REVERSE_PROXY=true below.
RATE_LIMIT_TRUSTED_PROXIES=
# Set to true ONLY if this backend is deliberately reachable directly from the
# internet with nothing forwarding on its behalf. Mutually exclusive with
# RATE_LIMIT_TRUSTED_PROXIES — the app refuses to boot if both are set.
RATE_LIMIT_NO_REVERSE_PROXY=false

# --- Seeded platform system admin (override before first boot) ---
# These credentials seed the SYSTEM_ADMIN account and are ALSO the browser
# login for the administration console (/api/admin/login). When the console is
# enabled in prod, the guard requires a real SYSTEM_ADMIN_PASSWORD: it refuses
# placeholder ("change-me"/"replace-me") or short (< 12 char) values.
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=change-me-in-production

# --- Embedded administration console (/api/admin/**) ---
# Disabled by default. When enabled, the console is protected by a server-side
# session form login backed by the SYSTEM_ADMIN account above (no separate
# console credentials). BACKEND_CONSOLE_USERNAME/PASSWORD are obsolete.
BACKEND_CONSOLE_ENABLED=false

# --- JVM ---
JAVA_OPTS=-XX:MaxRAMPercentage=75


