# Potriv mail stack — placeholders only. Never commit real values.
# Copy to .env.mail and fill in on the deployment host.

# --- Identity -------------------------------------------------------------
# Public hostname of the mail server. Must have A/AAAA + PTR pointing here.
MAIL_HOSTNAME=mail.aydgn.me
# Domain Potriv sends from.
MAIL_DOMAIN=potriv.aydgn.me
# The single sender identity the backend is allowed to use.
MAIL_FROM=noreply@potriv.aydgn.me

# --- Mail-server administration ------------------------------------------
# One-time bootstrap credential. Pin it here so the temporary password is not
# only printed to the container log. Rotate after provisioning; this account is
# NOT the account the backend authenticates with.
STALWART_RECOVERY_ADMIN=admin:replace-me-with-a-strong-password

# --- Backend SMTP credential ---------------------------------------------
# Dedicated application account, separate from the administrator above.
SMTP_HOST=potriv-mail
SMTP_PORT=587
SMTP_USERNAME=noreply@potriv.aydgn.me
SMTP_PASSWORD=replace-me-with-a-strong-password

# --- Public mail exposure -------------------------------------------------
# Bind address for port 25. Leave as 127.0.0.1 until DNS, PTR and outbound
# port 25 are actually in place; set to 0.0.0.0 to accept internet mail.
MAIL_PUBLIC_BIND=127.0.0.1
# Bind address for the management interface. Keep on loopback.
MAIL_ADMIN_BIND=127.0.0.1
# Host port for the management interface. Not 8080: the backend publishes that.
MAIL_ADMIN_PORT=8081
